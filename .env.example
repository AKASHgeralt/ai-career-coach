# Copy to backend/.env and fill in real values. Never commit the real file.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/career_coach
SECRET_KEY=changeme-generate-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GROQ_API_KEY=your-groq-api-key-here

# --- Optional ---------------------------------------------------------------
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# A GitHub personal access token raises the API rate limit from 60 to 5000
# requests per hour. Read-only public scope is enough.
GITHUB_TOKEN=

# How long a synced GitHub profile is reused before re-fetching.
GITHUB_CACHE_MINUTES=60

# Groq model id. Availability changes without notice — if calls start failing
# with model_not_found, set a currently-served model here.
GROQ_MODEL=openai/gpt-oss-120b

# gpt-oss models are reasoning models: they spend part of the completion budget
# on a private reasoning trace before answering. "low" keeps roadmap generation
# at ~3s instead of ~18s and stops long answers being truncated. Set to "none"
# for a model that does not accept the parameter.
GROQ_REASONING_EFFORT=low

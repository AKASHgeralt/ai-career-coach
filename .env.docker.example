# Copy to .env in the repository root for `docker compose up`.
# This is separate from backend/.env, which is used when running locally.

POSTGRES_USER=career
POSTGRES_PASSWORD=change-me
POSTGRES_DB=career_coach

SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GROQ_API_KEY=your-groq-api-key

# Optional
GITHUB_TOKEN=
GITHUB_CACHE_MINUTES=60
WEB_PORT=8080
WARM_UP_MODELS=background

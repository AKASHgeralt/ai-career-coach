# Copy to .env in the repository root for `docker compose up`.
# This is separate from backend/.env, which is used when running locally.

POSTGRES_USER=career
POSTGRES_PASSWORD=change-me
POSTGRES_DB=career_coach

SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GROQ_API_KEY=your-groq-api-key

# Optional
GITHUB_TOKEN=
GITHUB_CACHE_MINUTES=60
WEB_PORT=8080

# Groq model id. Availability changes without notice — if calls start failing
# with model_not_found, set a currently-served model here.
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss spends completion budget on a reasoning trace before answering.
# "low" keeps roadmap generation at ~3s instead of ~18s. Use "none" for a
# model that does not accept the parameter.
GROQ_REASONING_EFFORT=low

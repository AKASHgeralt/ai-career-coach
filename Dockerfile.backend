# syntax=docker/dockerfile:1

FROM python:3.11-slim AS base

# psycopg2 and PyMuPDF need a compiler and headers at install time; curl is used
# by the compose healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Dependencies first so application edits don't invalidate the (slow) pip layer.
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

# Nothing is written to disk at runtime: resumes are parsed in memory and never
# stored, and avatars live in the database, so the image needs no writable
# volume and no model cache.
RUN useradd --create-home --uid 1000 appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Migrations own the schema, so apply them before serving. Running this in the
# entrypoint rather than the image build means it happens against the real
# database, once it's reachable.
#
# $PORT is honoured because most managed hosts assign the port at runtime;
# it falls back to 8000 for compose and local use.
CMD ["sh", "-c", "alembic upgrade head && uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]

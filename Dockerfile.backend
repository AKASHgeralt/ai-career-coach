# syntax=docker/dockerfile:1

FROM python:3.11-slim AS base

# psycopg2 and PyMuPDF need a compiler and headers at install time; curl is used
# by the compose healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    # Keep the model cache inside the image rather than a per-user home dir.
    HF_HOME=/opt/models

WORKDIR /app

# Dependencies first so application edits don't invalidate the (slow) pip layer.
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Bake the sentence-transformer into the image. Without this the first skill-gap
# request in a fresh container downloads ~90MB, which fails outright in an
# air-gapped or rate-limited environment.
RUN python -c "from sentence_transformers import SentenceTransformer; \
SentenceTransformer('all-MiniLM-L6-v2')"

COPY backend/ .

# Uploads live on a volume; create the mount point with the right owner first.
RUN mkdir -p uploads/avatars \
    && useradd --create-home --uid 1000 appuser \
    && chown -R appuser:appuser /app /opt/models
USER appuser

EXPOSE 8000

# Migrations own the schema, so apply them before serving. Running this in the
# entrypoint rather than the image build means it happens against the real
# database, once it's reachable.
CMD ["sh", "-c", "alembic upgrade head && uvicorn main:app --host 0.0.0.0 --port 8000"]
